<Window x:Class="Glimule.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xml:lang="en"
        Title="Glimule — Settings"
        Icon="pack://application:,,,/Assets/Glimule.ico"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1C1C1E"
        Foreground="#F2F2F7">
    <Window.Resources>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Border x:Name="Track" CornerRadius="12" Background="#3A3A3C"/>
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0A84FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScaleSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="50"/>
            <Setter Property="Maximum" Value="200"/>
            <Setter Property="TickFrequency" Value="5"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="2" Background="#3A3A3C" VerticalAlignment="Center" Margin="8,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#0A84FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#0A84FF" Stroke="White" StrokeThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,22">
        <TextBlock Text="Glimule" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="Settings" FontSize="13" Foreground="#A1A1A6" Margin="0,2,0,18"/>

        <Border Background="#2C2C2E" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Capsule at the caret" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#A1A1A6" FontSize="12.5" Margin="0,6,0,0"
                               Text="When the caret is in a text field, the layout is shown next to it. Win+Space no longer opens the Windows language bar."/>
                </StackPanel>
                <CheckBox x:Name="CapsuleToggle" Grid.Column="1" Style="{StaticResource Switch}"
                          VerticalAlignment="Top" Margin="0,2,0,0"
                          Checked="SettingChanged" Unchecked="SettingChanged"/>
            </Grid>
        </Border>

        <Border Background="#2C2C2E" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Default scale" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="DefaultScaleToggle" Grid.Column="1" Style="{StaticResource Switch}"
                              VerticalAlignment="Center"
                              Checked="DefaultScaleChanged" Unchecked="DefaultScaleChanged"/>
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="ScaleSlider" Style="{StaticResource ScaleSlider}"
                            ValueChanged="ScaleChanged"/>
                    <TextBlock x:Name="ScaleLabel" Grid.Column="1" Text="100%" Width="52"
                               FontSize="14" Foreground="#A1A1A6" VerticalAlignment="Center"
                               TextAlignment="Right" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Background="#2C2C2E" CornerRadius="12" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Start with Windows" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#A1A1A6" FontSize="12.5" Margin="0,6,0,0"
                               Text="Open Glimule when you sign in."/>
                </StackPanel>
                <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource Switch}"
                          VerticalAlignment="Top" Margin="0,2,0,0"
                          Checked="SettingChanged" Unchecked="SettingChanged"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>
