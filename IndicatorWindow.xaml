<Window x:Class="Glimule.IndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glimule"
        Width="220"
        Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        IsHitTestVisible="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Canvas x:Name="Root" ClipToBounds="False">
        <Border x:Name="Shell"
                Height="26"
                CornerRadius="13"
                Padding="2"
                Background="#E62C2C2E"
                Opacity="0"
                RenderTransformOrigin="0,0"
                IsHitTestVisible="False">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="UserScale" ScaleX="1" ScaleY="1"/>
                    <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="16"
                                  ShadowDepth="0.5"
                                  Opacity="0.32"
                                  Direction="270"/>
            </Border.Effect>
            <Grid>
                <Canvas x:Name="SelectionHost" ClipToBounds="True">
                    <Border x:Name="Selection"
                            Width="22"
                            Height="22"
                            CornerRadius="11"
                            Canvas.Left="0"
                            Canvas.Top="0"/>
                </Canvas>
                <StackPanel x:Name="Langs" Orientation="Horizontal"/>
                <Viewbox x:Name="CapsHost"
                         Width="13"
                         Height="13"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="0"
                         IsHitTestVisible="False"
                         SnapsToDevicePixels="False">
                    <Canvas Width="18" Height="18">
                        <Path x:Name="CapsArrow"
                              Fill="Transparent"
                              Stroke="White"
                              StrokeThickness="1.9"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M9,1.35 L16.35,9.55 H12.15 V13.35 H5.85 V9.55 H1.65 Z"/>
                        <Path x:Name="CapsBar"
                              Fill="Transparent"
                              Stroke="White"
                              StrokeThickness="1.9"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M5.85,14.95 H12.15 A0.85,0.85 0 0 1 12.15,16.65 H5.85 A0.85,0.85 0 0 1 5.85,14.95 Z"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
    </Canvas>
</Window>
